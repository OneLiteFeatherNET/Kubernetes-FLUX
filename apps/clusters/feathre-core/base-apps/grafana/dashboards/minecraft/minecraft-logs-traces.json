      "pluginVersion": "12.3.1",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (job, detected_level) (\n  rate({exporter=\"OTLP\", job=~\"((minecraft|proxy)/)?$job\"} | detected_level=~\"$level\" [$__interval])\n) * 60\n",
