          "expr": "sum(kube_node_status_capacity_cpu_cores{job=\"opencost\"} + on(node) clamp_min(kube_node_status_capacity_memory_bytes{job=\"opencost\"} / 2^30 / 4 - on(node) kube_node_status_capacity_cpu_cores{job=\"opencost\"}, 0)) * $${hz_ccx_unit_month} + count(kube_node_status_capacity_cpu_cores{job=\"opencost\"}) * $${hz_ipv4_month}",
