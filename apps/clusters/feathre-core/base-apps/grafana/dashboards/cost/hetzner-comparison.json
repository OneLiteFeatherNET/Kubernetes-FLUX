    {
      "id": 2,
      "type": "stat",
      "title": "On-Prem (OpenCost)",
      "description": "Summe node_total_hourly_cost x Stunden/Monat plus PV-Kosten (pv_hourly_cost je GiB-Stunde x PV-Kapazitaet).",
      "datasource": {
        "type": "prometheus",
        "uid": "$${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(node_total_hourly_cost{job=\"opencost\"}) * $${hours} + sum(pv_hourly_cost{job=\"opencost\"} * on(persistentvolume) group_left() (kube_persistentvolume_capacity_bytes{job=\"opencost\"} / 2^30)) * $${hours}",
          "instant": true,
          "range": false,
          "legendFormat": "On-Prem (OpenCost)",
          "refId": "A"
        }
      ]
    },
