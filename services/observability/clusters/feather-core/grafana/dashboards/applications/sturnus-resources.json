      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "The worker's limit is 4 cores, and transcription will use every one of them. Sitting at the limit is expected here; what is not expected is sitting at the limit with nothing being decoded.",
      "gridPos": {
