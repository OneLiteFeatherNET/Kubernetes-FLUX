    {
      "id": 6,
      "type": "timeseries",
      "title": "Round outcomes by end reason",
      "description": "TraceQL metrics: cygnus.round spans per cygnus.game.end_reason (TIME_OVER, ALL_PAGES_FOUND, ALL_SURVIVOR_DEAD, SLENDER_LEFT, SURVIVOR_LEFT, shutdown). TraceQL metrics: Tempo limits the query range to 24h; pick a shorter time range.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && name=\"cygnus.round\"} | count_over_time() by (span.cygnus.game.end_reason)",
          "metricsQueryType": "range",
          "step": "5m",
          "limit": 100,
          "tableType": "traces",
          "legendFormat": "{{span.cygnus.game.end_reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Round duration p50 / p95",
      "description": "Span metrics: latency of cygnus.round (one round from lobby opening to restart ending).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"$service\", span_name=\"cygnus.round\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"$service\", span_name=\"cygnus.round\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Rounds",
      "description": "Tempo search: one row per cygnus.round span; click the trace ID to open the round. $round_id is only applied here, because cygnus.round.id exists on the round span, not on its child spans (so it cannot filter the other panels). Empty = all rounds.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 50,
          "query": "{resource.service.name=\"$service\" && name=\"cygnus.round\" && span.cygnus.round.id=~\".*$round_id.*\"} | select(span.cygnus.game.end_reason, span.cygnus.round.id, span.cygnus.links.dropped)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "nestedSpans": true
            }
          }
        }
      ]
    },
