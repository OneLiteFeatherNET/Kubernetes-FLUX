          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=~\"proxy/.*\"} |= \"[connected player]\" |= \"connected\" | json body=\"body\" | line_format \"{{.body}}\" | drop body | regexp `^\\[connected player\\] (?P<player>\\S+) \\(.*\\) has (?P<action>connected|disconnected)$` | action!=\"\" | player=~\"(?i)$player\" | line_format \"{{if eq .action \\\"connected\\\"}}🟢 {{.player}} hat das Netzwerk betreten{{else}}🔴 {{.player}} hat das Netzwerk verlassen{{end}}\"",
          "refId": "A",
          "editorMode": "code",
          "queryType": "range"
