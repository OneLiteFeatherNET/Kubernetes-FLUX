      "type": "logs",
      "title": "Wer kam und ging",
      "description": "Betreten und Verlassen des Netzwerks laut Proxy. IP-Adressen werden bewusst nicht angezeigt.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 11
