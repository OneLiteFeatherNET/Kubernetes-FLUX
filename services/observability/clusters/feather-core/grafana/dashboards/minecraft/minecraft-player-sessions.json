  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jetzt online",
      "description": "Spieler, die gerade über den Proxy verbunden sind.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(minecraft_proxy_players_online_ratio)",
          "refId": "A",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Verschiedene Spieler",
      "description": "Wie viele unterschiedliche Spieler im gewählten Zeitraum das Netzwerk betreten haben.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (player) (count_over_time({job=~\"proxy/.*\"} |= \"[connected player]\" |= \"connected\" | json body=\"body\" | line_format \"{{.body}}\" | drop body | regexp `^\\[connected player\\] (?P<player>\\S+) \\(.*\\) has (?P<action>connected|disconnected)$` | action!=\"\" | player=~\"(?i)$player\" | action=\"connected\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
