{
  "uid": "trivy-security",
  "title": "Trivy – Security Findings",
  "description": "Fixable findings only: trivy-operator scans with ignoreUnfixed=true and severity MEDIUM+, so every count here has an available fix. Low and Unknown are not shown. Counts are deduplicated per image, because old ReplicaSets report the same image.",
  "tags": [
    "security",
    "trivy"
  ],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "definition": "label_values(trivy_image_vulnerabilities, namespace)",
        "query": {
          "qryType": 1,
          "query": "label_values(trivy_image_vulnerabilities, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
