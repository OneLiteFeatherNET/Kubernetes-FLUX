        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "editorMode": "code",
          "expr": "count(max by (image) (label_join(label_join(trivy_image_vulnerabilities{namespace=~\"$namespace\",severity=\"Critical\"}, \"image\", \"/\", \"image_registry\", \"image_repository\"), \"image\", \":\", \"image\", \"image_tag\")) > 0) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
