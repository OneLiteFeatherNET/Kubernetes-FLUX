    },
    {
      "id": "logs_onelitefeather_net_label_schema",
      "label": "logs.onelitefeather.net pod-label schema (format/env/scrape/tenant)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/base-apps/alloy-logs/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Opt-in labels rather than global parsing: format=json enables JSON parsing only for apps that emit it (no parse-error spam / wasted CPU on plain-text apps), env separates prod/dev streams in Loki, and the scrape=false annotation is an explicit opt-out with scraping as the default."
    },
    {
      "id": "loki_label_cardinality_policy",
      "label": "Loki label cardinality policy (level as index label, logger as structured metadata)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/base-apps/alloy-logs/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "level is low-cardinality so it becomes a real index label for fast {level=\"ERROR\"} filtering; logger is higher-cardinality and is pushed to structured metadata instead. instance is kept as a label so Helm releases sharing the micronaut chart name stay distinguishable."
    },
    {
      "id": "alloy_ansi_strip_toplevel",
      "label": "Unconditional top-level ANSI strip stage",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/base-apps/alloy-logs/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A stage.replace nested inside stage.match was confirmed live not to mutate the line (selector matched but ANSI codes passed through). Root cause never isolated; moving the replace to top level sidesteps it and is a harmless no-op on lines without ANSI codes."
    },
    {
      "id": "alloy_metrics_clustering_shard_dedup",
      "label": "Alloy clustered metrics sharding replaces Prometheus Agent HA dedup",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/base-apps/alloy-metrics/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The 2 clustered replicas scrape disjoint shards of the discovered PodMonitor/ServiceMonitor targets, so unlike the retired 2x-replica Prometheus Agent there is no sample duplication and no Mimir-side HA dedup needed for this path. Discovery scope (all namespaces, no selector) matches the old agent's namespace selectors."
    },
    {
      "id": "otel_coldstart_startupprobe",
      "label": "startupProbe for OTel-instrumented JVM cold start",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/apps/otis/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "OTel bytecode instrumentation adds seconds to JVM cold start, pushing the first successful health check past the livenessProbe deadline; the pod was SIGTERM-looped before it ever finished starting. A startupProbe holds liveness off until startup completes."
    },
    {
      "id": "micronaut_kubernetes_health_indicator_disabled",
      "label": "KubernetesHealthIndicator disabled under k8s profile",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/apps/otis/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "client-java bundled with micronaut-kubernetes 7.1.1 cannot deserialize newer API-server pod fields (observedGeneration / PodReadyToStartContainers), so every /health probe logged ERROR+WARN. Service discovery itself is unaffected, so only the health indicator is disabled. The k8s profile must be listed explicitly because an explicit MICRONAUT_ENVIRONMENTS disables auto-deduction, and the chart requires one config file per profile."
    },
    {
      "id": "spegel_mutable_tag_stale_digest",
      "label": "Immutable image tags due to Spegel P2P cache",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/apps/vulpes-backend-dev/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Spegel caches mutable tags P2P, so \"latest\" kept resolving to a stale digest on vulpes-backend-dev; pinning an immutable version tag with pullPolicy IfNotPresent resolves correctly, at the cost of having to bump the tag per dev roll. otis-dev instead keeps latest with pullPolicy Always."
    },
    {
      "id": "ha_prod_rollout_pattern",
      "label": "HA prod rollout pattern (2 replicas, surge+1, anti-affinity, PDB)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/apps/otis/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "maxUnavailable 0 / maxSurge 1 gives seamless rollouts, host-topology podAntiAffinity spreads replicas across nodes, and a PDB with maxUnavailable 1 keeps node drains from taking the service down. Expressed entirely in native chart values, no postRenderer patches."
    },
    {
      "id": "dev_besteffort_no_pdb",
      "label": "Dev best-effort profile (single replica, no PDB, no priorityClass)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/apps/otis-dev/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dev deliberately omits priorityClassName and PDB so it yields to prod under node pressure; logging/JSON setup mirrors prod so behaviour matches, and only DB, domain and image tag differ."
    },
    {
      "id": "access_logger_probe_exclusions",
      "label": "Netty access-logger probe/metrics exclusions",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/apps/clusters/feathre-core/apps/otis/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "kubelet hits /health every 5-10s and Prometheus scrapes /prometheus; URI regex exclusions drop that noise. Because root is WARN, HTTP_ACCESS_LOGGER has to be raised to INFO explicitly for the remaining request logs to appear."
    }
  ],
