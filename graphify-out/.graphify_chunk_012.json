    {
      "id": "descheduler_release_descheduler",
      "label": "HelmRelease descheduler (chart 0.36.0, CronJob every 15m)",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/base/controllers/descheduler/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Runs as kind: CronJob on */15 * * * * rather than a Deployment, so no leader election or always-on pod is needed. Priority class system-cluster-critical because the descheduler is itself a cluster maintenance component. Chart version is pinned (0.36.0) here, unlike most other controller bases."
    },
    {
      "id": "descheduler_release_helmrepository_descheduler",
      "label": "HelmRepository descheduler (flux-system)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/base/controllers/descheduler/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "descheduler_release_defaultevictor",
      "label": "DefaultEvictor plugin config (nodeFit, priorityThreshold, PodsWithPVC)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/base/controllers/descheduler/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "nodeFit:true so eviction never creates Pending pods on a tight cluster. priorityThreshold pinned to the feather-high class as a hard guard rail: only pods strictly below feather-high (100000) are evictable, protecting Ceph, databases/Envoy/step-ca, monitoring/Harbor/Redis and system-*-critical. podProtections extraEnabled: PodsWithPVC so stateful data-backed pods are never evicted, on top of the built-in protections."
    },
    {
      "id": "descheduler_release_feather_priority_classes",
      "label": "feather-* PriorityClass tiers (critical/platform/high/standard/low)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/base/controllers/descheduler/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Cluster-wide priority scheme referenced as the eviction guard rail: feather-critical (Ceph), feather-platform (databases/Envoy/step-ca), feather-high=100000 (monitoring/Harbor/Redis), feather-standard=1000, feather-low=-10. Only the bottom two tiers and unprioritized workloads are rebalanced."
    },
    {
      "id": "descheduler_release_lownodeutilization",
      "label": "LowNodeUtilization balance plugin (20/50 thresholds)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/base/controllers/descheduler/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Bin-pack rebalancing: drains over-utilized nodes (above targetThresholds cpu/memory/pods 50) toward nodes idle below thresholds 20."
    },
    {
      "id": "descheduler_release_deschedule_plugins",
      "label": "Deschedule plugins (RemovePodsViolatingNodeAffinity, InterPodAntiAffinity)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/base/controllers/descheduler/release.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "NodeAffinity plugin restricted to requiredDuringSchedulingIgnoredDuringExecution, so pods move back when node labels changed after maintenance/reboot; anti-affinity plugin re-spreads pods that ended up co-located."
    },
    {
      "id": "dragonfly_operator_kustomization_kustomization",
