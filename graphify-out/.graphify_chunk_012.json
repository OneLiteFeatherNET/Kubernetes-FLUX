    {
      "id": "envoy_crds_kustomization_kustomization",
      "label": "envoy-crds base Kustomization (vendored CRDs)",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/base/controllers/envoy-crds/kustomization.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Gateway API (standard) + Envoy Gateway CRDs are vendored from gateway-crds-helm v1.7.3 and applied via Flux server-side apply because Helm release storage cannot be used: the rendered CRD set exceeds the 1Mi Kubernetes Secret limit even when split into separate Gateway API and Envoy Gateway HelmReleases (the Envoy half alone is too big). Re-vendor on a minor bump; patch bumps keep the same CRD schema."
    },
    {
      "id": "envoy_crds_crds_gateway_envoyproxy_io",
      "label": "Envoy Gateway CRDs (gateway.envoyproxy.io group)",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/base/controllers/envoy-crds/crds.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Includes backends, backendtrafficpolicies, clienttrafficpolicies, envoyextensionpolicies, envoypatchpolicies, envoyproxies, httproutefilters and securitypolicies; this half alone exceeds the 1Mi Secret limit for Helm release storage."
    },
    {
      "id": "envoy_crds_crds_gateway_networking_k8s_io",
      "label": "Gateway API standard CRDs (gateway.networking.k8s.io group)",
