    {
      "id": "workflows_pr_lint_conventional_commits",
      "label": "Conventional Commits policy",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/.github/workflows/pr-lint.yaml",
      "source_location": null,
      "source_url": null,
