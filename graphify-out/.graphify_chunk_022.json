    {
      "id": "scripts_validate_validate",
      "label": "validate.sh Flux manifest validation",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/scripts/validate.sh",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Discovers every Flux Kustomization spec.path from clusters/feather-core/*.yaml, kustomize-builds each, and pipes the render into kubeconform; tool versions are pinned so CI and local runs agree."
    },
    {
      "id": "scripts_validate_sops_patch_stripping",
      "label": "SOPS patch stripping into sanitized repo copy",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/scripts/validate.sh",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "CI has no sops-gpg key and kustomize cannot parse an encrypted patch, so the repo is mirrored to a temp dir and *.sops.yaml entries are removed from patches/patchesStrategicMerge/resources; the rest of the overlay still gets validated. Encrypted secretGenerator inputs are left alone because kustomize reads them as opaque bytes and the resulting Secrets are skipped anyway."
    },
    {
      "id": "scripts_validate_kubeconform_common",
      "label": "KUBECONFORM_COMMON schema policy",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/scripts/validate.sh",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Only upstream Kubernetes schemas are used: community CRD catalogs (datreeio) lag upstream and bake additionalProperties:false into schemas, so valid CRD fields fail regardless of -strict. -ignore-missing-schemas skips CRDs instead of rejecting them; Secrets are skipped because sops payloads are not valid plaintext."
    },
    {
      "id": "_claude_settings_local_permissions",
      "label": "Claude Code local permission allowlist",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/.claude/settings.local.json",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Allowlist accumulated from real operational sessions: kubectl/flux/helm/sops/git wildcards, talosctl against nodes 192.168.15.7-9 with the generated talosconfig, and WebFetch domains for rook.io, docs.ceph.com and Talos docs."
    },
    {
      "id": "workflows_flux_validate_validate",
      "label": "flux-validate workflow (kustomize build + kubeconform)",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/.github/workflows/flux-validate.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Triggers on PRs touching clusters/infrastructure/apps/helm plus the script and workflow themselves, and on every push to main, so broken manifests never reach the cluster."
    },
    {
      "id": "workflows_pr_lint_pr_title",
      "label": "pr-lint job: Conventional PR title",
