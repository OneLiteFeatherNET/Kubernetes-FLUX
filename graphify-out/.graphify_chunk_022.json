    {
      "id": "rook_release_ceph_csi_drivers",
      "label": "Ceph CSI drivers (RBD + CephFS provisioner/plugin)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/infrastructure/clusters/feather-core/rook/release.yaml",
