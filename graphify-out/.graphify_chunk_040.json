    {
      "id": "fr01_zone_pinning",
      "label": "fr01 zone pinning",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/controllers/dragonfly/dragonfly.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "ceph-rbd-fr01 is zone-local; RBD can only attach inside fr01, so stateful pods must be pinned to topology.kubernetes.io/zone=fr01. All current workers are in fr01 so the constraint is satisfiable and composes with per-host topology spread."
    },
    {
      "id": "postgresql_cluster_connection_saturation",
      "label": "Postgres connection saturation mitigation (max_connections=200)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/configs/postgresql/cluster.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Raised from the CNPG default 100 because the shared cluster sits at saturation (large idle pools, harbor ~26 + dependency-track ~23), starving apps of slots during restart storms. Memory bumped 1Gi -> 2Gi in lockstep (~5-10MB per backend); memory request==limit for OOM safety, CPU request only to avoid throttling the DB. Proper fix is pooler adoption + trimming idle pools."
    },
    {
      "id": "postgresql_pooler_rw_client_conn_ceiling",
      "label": "pgbouncer max_client_conn ceiling raise",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/configs/postgresql/pooler-rw.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Default max_client_conn (100) was exhausted by Harbor's oversized pool, blocking new client connections on the shared rw pooler (harbor + dependency-track). Client conns are cheap in pgbouncer so the ceiling is raised to 400; server conns stay bounded by default_pool_size=25 per (user,db) pool, aligned to Harbor's maxOpenConns, keeping total server conns well under PG's 200."
    },
    {
      "id": "postgresql_scheduled_backup_prefer_standby",
      "label": "Backup target prefer-standby with self owner reference",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/configs/postgresql/scheduled-backup.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "target: prefer-standby keeps backup I/O off the primary since the cluster runs standbys specifically for HA. backupOwnerReference: self ties each generated Backup to the ScheduledBackup instead of leaving them ownerless like the one-time backup.yaml, which had no owner and only ever ran once (2026-06-11) because no recurring schedule existed. immediate: true proves the schedule works without waiting for 02:00."
    },
    {
      "id": "dragonfly_dragonfly_lua_undeclared_keys",
      "label": "Dragonfly allow-undeclared-keys Lua flag",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/controllers/dragonfly/dragonfly.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "BullMQ (outline's task queue) runs Lua scripts touching keys not declared in KEYS[], which Dragonfly rejects by default. --default_lua_flags=allow-undeclared-keys restores Redis semantics; trade-off is that each Lua script locks the whole store (acceptable at this scale). Alternative would be hashtag queue names + --lock_on_hashtags."
    },
    {
      "id": "dragonfly_dragonfly_proactor_thread_pinning",
      "label": "Dragonfly proactor thread pinning and maxmemory",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/controllers/dragonfly/dragonfly.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dragonfly auto-detects all 32 host cores and demands 256MiB per thread (~8GiB), far above the 1536Mi limit, so it refuses to boot. Threads are pinned to 2 with --maxmemory=1gb; rule is maxmemory >= proactor_threads * 256MiB and scale threads and memory together. cache_mode is deliberately off so it behaves as a data store (no silent eviction), matching the Redis appendonly semantics shlink pub/sub and outline queues rely on."
    },
    {
      "id": "dragonfly_dragonfly_operator_pod_labels",
      "label": "dragonfly-operator pod label selector gotcha",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/controllers/dragonfly/dragonfly.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The operator sets `app: <CR name>` on pods but does NOT set app.kubernetes.io/instance; selecting on the latter makes the topology spread constraint silently no-op and pods co-locate, defeating the one-pod-per-host goal."
    },
    {
      "id": "postgresql_cluster_rw_external_lb",
      "label": "feather-core-cluster-pg-rw-external LoadBalancer service",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/configs/postgresql/cluster.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Additional rw-selector service exposed as a MetalLB LoadBalancer pinned to 10.200.90.3 via the metallb.io/loadBalancerIPs annotation, giving external clients a stable primary endpoint."
    }
  ],
