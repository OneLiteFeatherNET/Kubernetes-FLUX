    {
      "id": "agent_a3ff106175eed2f7a_sops_creation_rules",
      "label": "SOPS creation_rules (PGP recipients)",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/.sops.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Two rules: whole-file encryption for *.env/*.sops.*/dockerconfigjson/s3.conf suffixes, and field-level encryption for plain *.yaml restricted to an encrypted_regex of secret keys (ca_password, root_ca_key, .dockerconfigjson, ...). Adding a member means appending their fingerprint and re-running sops updatekeys per file."
    },
    {
      "id": "_vscode_settings_sops_integration",
      "label": "VSCode native SOPS editing settings",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/.vscode/settings.json",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Files matching a path_regex in .sops.yaml auto-decrypt on open and re-encrypt on save. .conf files have no recognized format so SOPS uses the binary store (JSON wrapper with a data key) — which is how s3.sops.conf and *-ingress-auth.sops.conf are stored."
    },
