    {
      "id": "agent_a3ff106175eed2f7a_claude_flux_layer_dependency_graph",
      "label": "Flux layer dependency graph (feather-core)",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Root GitRepository flux-system (ssh, main) drives a root Kustomization at ./clusters/feather-core; layers base-sources -> base-controllers -> controllers/base-configs -> rook -> rook-fr01/configs -> base-apps -> apps, plus rbac, internal-certs, monitoring. Most layers set wait:true, so a dependent blocks until its dependency is Ready at the same git revision — which is why forcing flux reconcile in a loop makes every dependent report 'dependency not ready'."
    },
    {
      "id": "agent_a3ff106175eed2f7a_claude_two_tier_kustomize_pattern",
      "label": "Two-tier Kustomize base + cluster overlay pattern",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Portable definitions live in infrastructure/base/<kind>/<name>/ and apps/base/<name>/; cluster overlays under clusters/<cluster>/<layer>/ reference a base, patch it (patches: - path: release.yaml) and attach secrets. Keeps HelmReleases reusable and cluster-specific values isolated."
    },
    {
      "id": "agent_a3ff106175eed2f7a_claude_path_spelling_gotcha",
      "label": "feather-core vs feathre-core path-spelling gotcha",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "infrastructure uses clusters/feather-core/ while apps uses the misspelled clusters/feathre-core/. Both are real, intentional paths referenced by Flux Kustomizations — 'fixing' one silently breaks a layer's path."
    },
    {
      "id": "agent_a3ff106175eed2f7a_claude_sops_secret_workflow",
      "label": "SOPS PGP secret workflow for the cluster",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Secrets reach pods via Kustomize secretGenerator (envs:/files:) or generators: in an overlay kustomization; Flux decrypts at apply time using provider sops / secret sops-gpg on every layer except internal-certs. This worktree copy claims recipients live in TWO files (.sops.yaml plus clusters/feather-core/.sops.yaml) that must stay in sync."
    },
    {
      "id": "agent_a3ff106175eed2f7a_claude_helm_chart_version_bump",
      "label": "In-repo Helm chart version-bump requirement",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Charts under helm/ are pulled by the helmcharts GitRepository pointing back at this repo's main; Flux/Helm caches by chart version, so template/values edits without a Chart.yaml version: bump are never re-rendered onto the cluster."
    },
    {
      "id": "agent_a3ff106175eed2f7a_claude_disablenamesuffixhash",
      "label": "disableNameSuffixHash: stable generated Secret/ConfigMap names",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/CLAUDE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Overlays set generatorOptions.disableNameSuffixHash: true so names stay stable and overlays can reference them; the trade-off is that changing a secret's contents does not roll the consuming Deployment — an explicit kubectl rollout restart is required."
    },
    {
      "id": "agent_a3ff106175eed2f7a_readme_kubernetes_cluster_management",
      "label": "README: Kubernetes Cluster Management toolchain",
      "file_type": "document",
      "source_file": ".claude/worktrees/agent-a3ff106175eed2f7a/README.md",
