    {"id": "pod_security_privileged_namespace", "label": "Pod Security Admission privileged namespace label set", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/kube-prometheus-stack/namespace.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "enforce/audit/warn are all set to privileged because node-exporter and the Prometheus stack's host-level collectors need hostPath, host network and host PID, which the baseline/restricted PSA levels reject."},
    {"id": "helmrelease_crd_upgrade_policy", "label": "HelmRelease CRD policy install:Create / upgrade:CreateReplace", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/kube-prometheus-stack/release.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Helm does not upgrade CRDs by default, so a chart-shipped CRD would go stale after the first install; CreateReplace on upgrade keeps the monitoring CRDs in step with the chart version."},

