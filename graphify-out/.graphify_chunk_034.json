    {"id": "operator_high_availability_pattern", "label": "Operator HA pattern: 3 replicas + hostname anti-affinity + PDB", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/mariadb-operator/release.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ha.replicas=3 with requiredDuringScheduling pod anti-affinity on kubernetes.io/hostname spreads the operator (and its validating webhook, which is on the write path for every MariaDB CR) across nodes; pdb.maxUnavailable=1 keeps a quorum during node drains."},
