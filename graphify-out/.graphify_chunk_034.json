    {"id": "descheduler_release_descheduler", "label": "HelmRelease descheduler (CronJob, every 15m)", "file_type": "code", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/descheduler/release.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "helmrepository_descheduler", "label": "HelmRepository descheduler (flux-system)", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/descheduler/release.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "feather_priority_class_tiers", "label": "feather-* PriorityClass tiers", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/descheduler/release.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cluster workloads are ranked feather-critical (Ceph) > feather-platform (databases, Envoy, step-ca) > feather-high (100000: monitoring, Harbor, Redis) > feather-standard (1000) > feather-low (-10). The tiering exists so a single numeric threshold can express 'never touch the platform'."},
    {"id": "descheduler_eviction_safety_policy", "label": "Descheduler eviction guard rails (nodeFit, priorityThreshold, PodsWithPVC)", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/descheduler/release.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nodeFit:true avoids creating Pending pods on a tight cluster; priorityThreshold feather-high makes only feather-standard/low/unprioritized pods eligible; extra PodProtection PodsWithPVC keeps stateful data safe. Rebalancing (RemoveDuplicates, LowNodeUtilization 20/50, topology-spread and anti-affinity plugins) is therefore limited to disposable workloads."},

    {"id": "dragonfly_operator_kustomization", "label": "dragonfly-operator base kustomization", "file_type": "code", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/dragonfly-operator/kustomization.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "dragonfly_operator_upstream_manifest", "label": "Pinned upstream dragonfly-operator.yaml (v1.6.1 raw URL)", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/dragonfly-operator/kustomization.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The operator ships its own namespace, CRDs, RBAC and Deployment in one upstream manifest, so no chart is used; the version is pinned inside the raw GitHub URL specifically so Renovate can bump the tag."},

