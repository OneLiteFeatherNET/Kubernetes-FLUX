    {"id": "envoy_gateway_crds", "label": "Envoy Gateway CRDs (gateway.envoyproxy.io)", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/envoy-crds/crds.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "crd_secret_size_limit_workaround", "label": "CRD vendoring to dodge the 1Mi Helm release Secret limit", "file_type": "concept", "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/base/controllers/envoy-crds/kustomization.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Helm release storage cannot hold the rendered CRD set: it exceeds the 1Mi Kubernetes Secret limit even split into separate Gateway API and Envoy Gateway HelmReleases (the Envoy half alone is too big). The CRDs are therefore vendored into git and applied by Flux server-side apply; re-vendor on a minor bump, patch bumps keep the same schema."},

