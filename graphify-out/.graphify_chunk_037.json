    {
      "id": "gateway_envoyproxy_tempo_otlp_sink",
      "label": "Tempo OTLP tracing sink tempo-gateway.grafana:4317",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/configs/gateway/envoyproxy.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Sampling is held at 10% because the gateway fronts every ingress route and full sampling already OOM-killed tempo-ingester; host/port is used instead of backendRefs to avoid a cross-namespace ReferenceGrant from envoy to grafana for a plain internal sink."
    },
