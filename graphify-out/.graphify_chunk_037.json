    {
      "id": "gateway_envoyproxy_eg_proxy",
      "label": "EnvoyProxy eg-proxy",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/infrastructure/clusters/feather-core/configs/gateway/envoyproxy.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Envoy data plane runs as a DaemonSet for parity with the replaced ingress-nginx DaemonSet; combined with externalTrafficPolicy: Local and MetalLB BGP every node announces 10.200.90.1 so the external reverse proxy reaches the gateway on any node while preserving client source IP."
    },
