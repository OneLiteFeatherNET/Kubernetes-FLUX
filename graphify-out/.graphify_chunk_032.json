    {
      "id": "micronaut_values_rollingupdatestrategy",
      "label": "micronaut deployment update strategy",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Left empty so Kubernetes default RollingUpdate 25%/25% applies; seamless updates with >=2 replicas need maxUnavailable 0 / maxSurge 1 set explicitly."
    },
    {
      "id": "outline_chart_outlinechart",
      "label": "outline helm chart",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/Chart.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "outline_values_componentmodel",
      "label": "outline component deployment model",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Outline ships a single image whose sub-services are selected via the SERVICES env var. Each service runs as its own stateless Deployment (a 'component') so node failures and rolling updates cause no outage; nothing is a StatefulSet because all state lives in Postgres, Redis and S3."
    },
    {
      "id": "outline_values_web",
      "label": "outline web component",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Runs SERVICES=\"web,websockets,worker,cron\" because websockets and the BullMQ services do not work standalone: websockets attaches to the web HTTP server and has no WEBSOCKETS_URL of its own, and an isolated worker/cron grows memory unbounded. Duplicating cron across web replicas is safe because BullMQ repeatable jobs are idempotent."
    },
    {
      "id": "outline_values_collaboration",
      "label": "outline collaboration component",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Hocuspocus realtime editing served under /collaboration; scales independently of web, but running more than one replica requires REDIS_COLLABORATION_URL in the .env secret for cross-replica sync."
    },
    {
      "id": "outline_values_rediscollaborationurl",
      "label": "redis collaboration url requirement",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "websockets syncs via REDIS_URL (socket.io adapter, already set), but collaboration needs its own REDIS_COLLABORATION_URL in the .env secret before it can be scaled past one replica."
    },
    {
      "id": "outline_values_routes",
      "label": "outline path routing table",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Each container only serves the routes of its own SERVICES, so the gateway must map /collaboration to the collaboration Service and / to the web Service (which also serves /realtime via socket.io)."
    },
    {
      "id": "outline_values_cloudflaretunnelexposure",
      "label": "outline cloudflare tunnel exposure",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The chart's own ingress and httpRoute are both disabled; real external exposure is an out-of-chart Cloudflare Tunnel Ingress, so the routes list only documents the intended path mapping."
    },
    {
      "id": "outline_values_topologyspread",
      "label": "outline topology spread constraints",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/values.yaml",
      "source_location": null,
      "source_url": null,
