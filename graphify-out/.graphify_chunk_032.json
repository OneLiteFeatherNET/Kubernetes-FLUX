    {
      "id": "templates_deployment_shlinksecretchecksum",
      "label": "shlink secret checksum pod annotation",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/shlink/templates/deployment.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "checksum/secrets is a sha256sum of the rendered secret.yaml injected as a pod annotation, so changing secret contents changes the pod template hash and forces a rollout - the chart-level answer to the repo-wide problem that disableNameSuffixHash makes generated Secret names stable and therefore non-rolling."
    },
    {
      "id": "templates_ingress_shlinkkubeversioncompat",
      "label": "shlink ingress api version compatibility shim",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/shlink/templates/ingress.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "semverCompare on .Capabilities.KubeVersion picks networking.k8s.io/v1, v1beta1 or extensions/v1beta1, and falls back to the kubernetes.io/ingress.class annotation below 1.18 where ingressClassName does not exist. The outline chart dropped this shim and hardcodes networking.k8s.io/v1."
    }
