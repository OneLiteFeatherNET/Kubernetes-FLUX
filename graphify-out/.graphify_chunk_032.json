{
  "nodes": [
    {
      "id": "micronaut_values_micronautchartvalues",
      "label": "micronaut chart default values",
      "file_type": "code",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "micronaut_values_tracing",
      "label": "micronaut otel java agent tracing",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Traces-only: metrics already flow via the chart's own Prometheus scrape and logs via container stdout shipping, so enabling only OTEL_TRACES_EXPORTER avoids duplicating either. An initContainer copies the javaagent jar out of the upstream image into an emptyDir instead of pulling in the OpenTelemetry Operator/CRDs. Pinned to autoinstrumentation-java:2.29.0 because otis/vulpes-backend run JDK 25 and older javaagent releases fail to attach (InaccessibleObjectException on ClassLoader.findLoadedClass - java.base does not open java.lang to the unnamed module); 2.29.0 carries the JDK23+ MethodHandles.Lookup fix for boot-loader class injection."
    },
    {
      "id": "micronaut_values_startupprobe",
      "label": "micronaut startup probe",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Off by default; mainly needed when tracing is enabled, because OTel bytecode instrumentation adds seconds to JVM cold start (class transformation on Micronaut/Hibernate/Hikari) and can push first-successful-health past the livenessProbe steady-state deadline, SIGTERM-looping the pod before it finishes starting. Reuses the readiness path/port since that is the only health endpoint the app exposes."
    },
    {
      "id": "micronaut_values_rbac",
      "label": "micronaut kubernetes discovery rbac",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Creates a namespace-scoped Role + RoleBinding granting the ServiceAccount read access to services and endpoints, as required by micronaut-kubernetes-discovery-client. Off by default so charts without service discovery get no extra permissions."
    },
    {
      "id": "micronaut_values_metricsservicemonitor",
      "label": "micronaut metrics servicemonitor values",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "micronaut_values_containersecuritycontext",
      "label": "micronaut hardened container security context",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Enabled by default with allowPrivilegeEscalation false, readOnlyRootFilesystem true and all capabilities dropped - the opposite default of the upstream Helm scaffold, whose securityContext blocks stay empty."
    },
    {
      "id": "micronaut_values_tempogateway",
      "label": "tempo gateway otlp endpoint",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "http://tempo-gateway.grafana.svc.cluster.local:4317 is deliberately the same target already used by EnvoyProxy native tracing and the alloy-receiver OTLP gateway elsewhere in the cluster, so all trace producers converge on one collector."
    },
    {
      "id": "micronaut_values_poddisruptionbudget",
      "label": "micronaut poddisruptionbudget values",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Disabled by default so single-replica apps are unaffected; minAvailable wins over maxUnavailable when both are set."
    },
    {
      "id": "micronaut_values_httproute",
      "label": "micronaut httproute values",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/micronaut/values.yaml",
