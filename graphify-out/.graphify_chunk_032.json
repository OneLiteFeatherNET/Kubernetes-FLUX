      "author": null,
      "contributor": null
    },
    {
      "id": "outline_values_metricscomponent",
      "label": "outline metrics component selector",
      "file_type": "concept",
      "source_file": ".claude/worktrees/agent-a5f46601e4bdeb874/helm/outline/values.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Only the web process exposes /metrics, so metrics.component pins scraping (and the helm test) to that one component instead of all Deployments."
    },
