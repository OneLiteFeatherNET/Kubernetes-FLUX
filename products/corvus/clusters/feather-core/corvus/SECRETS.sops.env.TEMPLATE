# =============================================================================
# TEMPLATE -- NOT a real secret, NOT encrypted, NOT wired into any kustomization.
# Lists the key names of every encrypted input in this directory. Each block is a
# separate file: fill in, `sops -e -i <file>`, and keep the name given in the
# header. Never commit a filled-in copy in plaintext.
# =============================================================================

# --- database.sops.env  (Secret corvus-database) -----------------------------
# Mirrors a CNPG app secret. The password is the one in
# foundation/databases/clusters/feather-core/postgresql/roles/corvus.sops.env.
# The DSN uses the -rw service on purpose (advisory locks, no transaction pooler).
#   uri=postgresql://corvus:<password>@feather-core-cluster-pg-rw.cnpg-system.svc.cluster.local:5432/corvus
#   host=feather-core-cluster-pg-rw.cnpg-system.svc.cluster.local
#   port=5432
#   dbname=corvus
#   user=corvus
#   username=corvus
#   password=<password>

# --- kek.sops.env  (Secret corvus-kek) ----------------------------------------
# Key encryption key, base64 of 32 random bytes: openssl rand -base64 32
# LOSING IT MAKES EVERY STORED PLAYER KEY, AND ALL RAW PAYLOADS, UNREADABLE.
#   kek=<base64>

# --- pseudonym.sops.env  (Secret corvus-pseudonym) ------------------------------
# Pseudonym key, base64, >= 16 bytes. Must equal the key in the Velocity plugin.
#   key=<base64>

# --- api-extra.sops.env  (Secret corvus-api-extra) -------------------------------
# Bearer token(s) of the Velocity proxies for GET /api/v1/plugin/blocklist,
# comma separated, plain values: openssl rand -hex 32
#   CORVUS_API_PLUGIN_TOKENS=<token>

# --- job-tokens.sops.env  (Secret corvus-job-tokens) -----------------------------
# <sha256 hex of the ML job token>:<job name>, comma separated:
#   printf %s "$token" | sha256sum | cut -d' ' -f1
#   job-tokens=<sha256>:train

# --- jobs-env.sops.env  (Secret corvus-jobs-env) ---------------------------------
# Environment of the training / evaluation Job pods (api.jobs.envSecret).
#   CORVUS_API_URL=http://corvus-api:8080
#   CORVUS_API_TOKEN=<plain token; its SHA-256 is listed in job-tokens.sops.env>
#   CORVUS_S3_ENDPOINT_URL=http://rook-ceph-rgw-feather-s3.rook-ceph-fr01.svc:80
#   CORVUS_S3_BUCKET=corvus-lake
#   CORVUS_S3_ACCESS_KEY / CORVUS_S3_SECRET_KEY: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#     of the Secret corvus-lake (the ObjectBucketClaim), once the claim is bound:
#       kubectl -n corvus get secret corvus-lake -o jsonpath='{.data.AWS_ACCESS_KEY_ID}' | base64 -d
#   CORVUS_PG_DSN=postgresql://corvus_jobs@feather-core-cluster-pg-rw.cnpg-system.svc.cluster.local:5432/corvus
#   PGPASSWORD=<password of roles/corvus-jobs.sops.env in foundation/databases/.../postgresql>
#   CORVUS_KEK=<same value as kek in kek.sops.env>

# --- nats-ingest.sops.conf / nats-score.sops.conf  (Secret corvus-nats) ----------
# NATS .creds files (JWT + NKEY seed) of the users corvus-ingest and corvus-score
# of the CORVUS account. Issue them with nsc (see
# foundation/messaging/clusters/feather-core/nats/nats-auth.sops.conf.TEMPLATE):
#   nsc generate creds -a CORVUS -n corvus-ingest > nats-ingest.sops.conf

# --- harbor.onelitefeather.dev.dockerconfigjson.sops.json  (Secret harbor-pull) --
# Same shared robot account as the other apps in the onelitefeather Harbor project.
