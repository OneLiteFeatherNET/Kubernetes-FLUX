# --- keys.sops.env  (Secret blackhole-keys) ------------------------------------
# Dev keys, different from prod. Losing them only loses dev Ban IDs.
#   BLACKHOLE_BANID_KEY=<openssl rand -base64 32>
#   BLACKHOLE_EVASION_IP_SALT=<openssl rand -base64 32>

# --- discord.sops.env  (Secret blackhole-discord) -------------------------------
# A separate Discord application and test guild for dev, and the Entra app "Blackhole Discord (dev)".
#   DISCORD_TOKEN=<dev bot token>
#   BLACKHOLE_DISCORD_CLIENT_SECRET=<Entra client secret of the dev bot>

# --- nats-backend.sops.conf / nats-discord.sops.conf  (Secrets blackhole-nats, blackhole-nats-discord) --
# Own account BLACKHOLE_DEV: the stream and subjects are fixed (BLACKHOLE_EVENTS,
# blackhole.events.>), so dev inside the BLACKHOLE account would share them with prod and the
# Velocity proxies would see dev events. Same permissions as prod (../blackhole/SECRETS.sops.env.TEMPLATE),
# smaller JetStream quota, no velocity user.
#
#   nsc add account BLACKHOLE_DEV
#   nsc edit account BLACKHOLE_DEV --js-mem-storage 0 --js-disk-storage 1G --js-streams 1 --js-consumer 8
#   # Repeat the `nsc add user` commands of the prod template with
#   #   --account BLACKHOLE_DEV and the names blackhole-dev-backend / blackhole-dev-discord
#   # (identical --allow-pub / --allow-sub lists), then:
#   nsc edit user blackhole-dev-backend --account BLACKHOLE_DEV --conn-type STANDARD
#   nsc edit user blackhole-dev-discord --account BLACKHOLE_DEV --conn-type STANDARD
#   nsc generate creds --account BLACKHOLE_DEV --name blackhole-dev-backend > nats-backend.sops.conf
#   nsc generate creds --account BLACKHOLE_DEV --name blackhole-dev-discord > nats-discord.sops.conf
#   sops -e -i nats-backend.sops.conf && sops -e -i nats-discord.sops.conf
#   nsc describe account BLACKHOLE_DEV --raw   # public key + JWT for resolver_preload in nats-auth.sops.conf

