# =============================================================================
# TEMPLATE -- NOT a real secret, NOT encrypted, NOT wired into any kustomization.
# Lists every encrypted input of this directory that kustomization.yaml references
# and that is NOT committed yet, so `kustomize build` fails until all of them exist.
# Each block is one file: create it with the name in the header, fill in the values,
# then encrypt it IN PLACE (the .sops.yaml rule matches the file name):
#
#   sops -e -i <file>
#
# Never commit a filled-in copy in plaintext. Afterwards run
#   python3 .github/scripts/check-sops-encryption.py
# and ./.github/scripts/validate.sh.
#
# Key names are fixed by the chart (deploy/charts/blackhole, README "Secrets the chart
# expects"). The dev directory (../blackhole-dev) needs the same files with dev values.
# =============================================================================

# --- harbor.onelitefeather.dev.dockerconfigjson.sops.json  (Secret harbor-pull) --
# The shared robot of the onelitefeather Harbor project. Already encrypted to our
# recipients, so copy it instead of creating a new one:
#   cp ../../../../vulpes/clusters/feather-core/vulpes-backend/harbor.onelitefeather.dev.dockerconfigjson.sops.json .

# --- database.sops.env  (Secret blackhole-db) ---------------------------------
# The direct -rw service, not a pooler: Flyway takes an advisory lock and the migration
# runs on every start. The password is the one in
# foundation/databases/clusters/feather-core/postgresql/roles/blackhole.sops.env
# (see roles/blackhole.sops.env.TEMPLATE there; generate it once, use it in both files).
#   JDBC_URL=jdbc:postgresql://feather-core-cluster-pg-rw.cnpg-system.svc.cluster.local:5432/blackhole
#   JDBC_USER=blackhole
#   JDBC_PASSWORD=<password>

# --- redis.sops.env  (Secret blackhole-redis) ----------------------------------
# Dragonfly. The password goes INTO the URI (clients ignore a separate password for a
# standalone server). Take it from foundation/databases/clusters/feather-core/dragonfly/dragonfly.env
# (key `password`): sops decrypt foundation/databases/clusters/feather-core/dragonfly/dragonfly.env
# Database index 10 for prod (11 for dev) -- check that no other app uses the index.
#   REDIS_URI=redis://:<dragonfly password>@dragonfly.dragonfly.svc.cluster.local:6379/10

# --- keys.sops.env  (Secret blackhole-keys) ------------------------------------
# BLACKHOLE_BANID_KEY CANNOT BE REPLACED after the first start: every Ban ID becomes
# unreadable. Put an offline copy into the team password manager BEFORE the first start.
#   BLACKHOLE_BANID_KEY=$(openssl rand -base64 32)
#   BLACKHOLE_EVASION_IP_SALT=$(openssl rand -base64 32)
# (write the generated values, not the command substitution, into the file)

# --- discord.sops.env  (Secret blackhole-discord) -------------------------------
#   DISCORD_TOKEN=<Discord developer portal > Application > Bot > Reset Token>
#   BLACKHOLE_DISCORD_CLIENT_SECRET=<Entra > app registration "Blackhole Discord (prod)" > Certificates & secrets>
# Optional: the staff audit channel. Without DISCORD_AUDIT_WEBHOOK_URL the audit is off in the bot (the chart
# references the key with optional: true, so the Secret starts without it). Create the webhook in the audit
# channel (Edit channel > Integrations > Webhooks) and add the line:
#   DISCORD_AUDIT_WEBHOOK_URL=<webhook URL of the audit channel>
# Note the client secret's expiry date in the team calendar.

# --- nats-backend.sops.conf / nats-discord.sops.conf  (Secrets blackhole-nats, blackhole-nats-discord) --
# NATS .creds files (JWT + NKEY seed): the whole output of `nsc generate creds`, written to the
# file name above and encrypted with `sops -e -i`. Create the account and the users first:
#
#   # --- on a workstation with the nsc keystore (operator signing key from the password manager)
#   # Subjects and rationale: openspec/changes/switch-event-bus-to-nats/design.md, D6, in the
#   # Blackhole repo. Run for prod; the dev account is in ../blackhole-dev/SECRETS.sops.env.TEMPLATE.
#   nsc add account BLACKHOLE
#   nsc edit account BLACKHOLE --js-mem-storage 0 --js-disk-storage 5G --js-streams 1 --js-consumer 8
#
#   # backend: the only publisher; manages stream BLACKHOLE_EVENTS and the durable blackhole-redis-sync
#   nsc add user blackhole-backend --account BLACKHOLE \
#     --allow-pub 'blackhole.events.>' \
#     --allow-pub '$JS.API.STREAM.CREATE.BLACKHOLE_EVENTS' --allow-pub '$JS.API.STREAM.UPDATE.BLACKHOLE_EVENTS' \
#     --allow-pub '$JS.API.STREAM.INFO.BLACKHOLE_EVENTS' \
#     --allow-pub '$JS.API.CONSUMER.CREATE.BLACKHOLE_EVENTS.blackhole-redis-sync' \
#     --allow-pub '$JS.API.CONSUMER.CREATE.BLACKHOLE_EVENTS.blackhole-redis-sync.>' \
#     --allow-pub '$JS.API.CONSUMER.DURABLE.CREATE.BLACKHOLE_EVENTS.blackhole-redis-sync' \
#     --allow-pub '$JS.API.CONSUMER.INFO.BLACKHOLE_EVENTS.blackhole-redis-sync' \
#     --allow-pub '$JS.API.CONSUMER.MSG.NEXT.BLACKHOLE_EVENTS.blackhole-redis-sync' \
#     --allow-pub '$JS.ACK.BLACKHOLE_EVENTS.blackhole-redis-sync.>' \
#     --allow-sub '_INBOX.>'
#
#   # discord bot: never publishes events, owns two durables
#   nsc add user blackhole-discord --account BLACKHOLE \
#     --allow-pub '$JS.API.STREAM.INFO.BLACKHOLE_EVENTS' \
#     --allow-pub '$JS.API.CONSUMER.CREATE.BLACKHOLE_EVENTS.blackhole-discord-notify' \
#     --allow-pub '$JS.API.CONSUMER.CREATE.BLACKHOLE_EVENTS.blackhole-discord-notify.>' \
#     --allow-pub '$JS.API.CONSUMER.DURABLE.CREATE.BLACKHOLE_EVENTS.blackhole-discord-notify' \
#     --allow-pub '$JS.API.CONSUMER.INFO.BLACKHOLE_EVENTS.blackhole-discord-notify' \
#     --allow-pub '$JS.API.CONSUMER.MSG.NEXT.BLACKHOLE_EVENTS.blackhole-discord-notify' \
#     --allow-pub '$JS.ACK.BLACKHOLE_EVENTS.blackhole-discord-notify.>' \
#     --allow-pub '$JS.API.CONSUMER.CREATE.BLACKHOLE_EVENTS.blackhole-discord-case' \
#     --allow-pub '$JS.API.CONSUMER.CREATE.BLACKHOLE_EVENTS.blackhole-discord-case.>' \
#     --allow-pub '$JS.API.CONSUMER.DURABLE.CREATE.BLACKHOLE_EVENTS.blackhole-discord-case' \
#     --allow-pub '$JS.API.CONSUMER.INFO.BLACKHOLE_EVENTS.blackhole-discord-case' \
#     --allow-pub '$JS.API.CONSUMER.MSG.NEXT.BLACKHOLE_EVENTS.blackhole-discord-case' \
#     --allow-pub '$JS.ACK.BLACKHOLE_EVENTS.blackhole-discord-case.>' \
#     --allow-sub '_INBOX.>'
#
#   # velocity: subscribe-only, WebSocket-only, no publishing at all (runs outside the cluster)
#   nsc add user blackhole-velocity --account BLACKHOLE \
#     --deny-pub '>' \
#     --allow-sub 'blackhole.events.punishment.*' --allow-sub 'blackhole.events.appeal.resolved' \
#     --allow-sub 'blackhole.events.section.changed' --allow-sub 'blackhole.events.report.created' \
#     --allow-sub 'blackhole.events.report.feedback'
#   nsc edit user blackhole-velocity --account BLACKHOLE --conn-type WEBSOCKET
#   nsc edit user blackhole-backend  --account BLACKHOLE --conn-type STANDARD
#   nsc edit user blackhole-discord  --account BLACKHOLE --conn-type STANDARD
#
#   # creds files stay on the workstation; the two in-cluster ones are encrypted before git
#   nsc generate creds --account BLACKHOLE --name blackhole-backend  > nats-backend.sops.conf
#   nsc generate creds --account BLACKHOLE --name blackhole-discord  > nats-discord.sops.conf
#   nsc generate creds --account BLACKHOLE --name blackhole-velocity > blackhole-velocity.creds  # for the proxy operator, NOT in git
#   sops -e -i nats-backend.sops.conf && sops -e -i nats-discord.sops.conf
#
#   # resolver_preload of the server: only the account public key and the signed JWT
#   nsc describe account BLACKHOLE --raw
#   # then, in foundation/messaging/clusters/feather-core/nats/:
#   #   sops nats-auth.sops.conf   -> add the BLACKHOLE entry next to CORVUS (see nats-auth.sops.conf.TEMPLATE)
#
# The velocity creds file leaves the cluster and is a long-lived secret. Rotate by creating a new
# user, deploying it, then `nsc revocations add-user`.

# --- metrics.sops.env  (Secret blackhole-metrics) -- OPTIONAL, not referenced yet --
# Only for the backend ServiceMonitor (disabled in release.yaml). To enable: add a
# secretGenerator entry `blackhole-metrics` for this file, set
# backend.metrics.serviceMonitor.enabled: true and ...oauth2.existingSecret: blackhole-metrics.
#   BLACKHOLE_METRICS_CLIENT_ID=<Entra app "Blackhole Metrics" client id>
#   BLACKHOLE_METRICS_CLIENT_SECRET=<its client secret>

# --- Values that are NOT secrets but still need filling in release.yaml ----------
# Everything marked PLACEHOLDER: Entra API / panel / bot client ids and the four group object
# ids (output of docs/entra-setup.sh in the Blackhole repo), the Discord snowflakes. Then add
# the redirect URIs for https://blackhole.onelitefeather.net in the Entra panel app.
